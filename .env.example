# Optional local .env is loaded at application entry; process environment takes precedence.
DATABASE_URL=sqlite:///./simulator.db
# M2 real provider (OpenAI-compatible chat completions); never stored in traces.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Reasoning models spend hidden reasoning against the completion budget; raise this
# (max 16384) when replies are truncated. Default 2048.
LLM_MAX_TOKENS=2048
